# Copiá este archivo como .env y completalo SOLO en tu computadora.
# Nunca subas .env a GitHub ni envíes estos valores por chat.

PORT=3000
TWITCH_CLIENT_ID=pega_aqui_tu_client_id
TWITCH_CLIENT_SECRET=pega_aqui_tu_client_secret
TWITCH_REDIRECT_URI=http://localhost:3000/auth/twitch/callback

# Generá una frase larga y única para proteger las sesiones del navegador.
SESSION_SECRET=reemplaza_esto_por_una_frase_larga_y_aleatoria

# Firma la URL permanente del Viewer. Usá otro valor largo y aleatorio.
VIEWER_URL_SECRET=reemplaza_esto_por_otro_valor_largo_y_aleatorio

# Base de datos de Tango GG. La clave secret solo se usa en server.js.
SUPABASE_URL=https://tu-project-ref.supabase.co
SUPABASE_SECRET_KEY=pega_aqui_tu_supabase_secret_key

# Al crear el bucket de archivos, usá este nombre. Sin esta línea el proyecto
# sigue usando la carpeta local public/uploads como respaldo temporal.
SUPABASE_STORAGE_BUCKET=overlay-assets

# Beta abierta: no vencen los proyectos por los 7 días de prueba.
# Cuando Tango GG tenga suscripciones activas, cambiá este valor a true en Render.
ENFORCE_SUBSCRIPTIONS=false
